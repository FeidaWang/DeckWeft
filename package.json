{
  "name": "deckweft",
  "version": "0.1.0-alpha.2",
  "description": "Local-first slide studio with explainable layouts, editable exports, and portable agent skills.",
  "type": "module",
  "license": "MIT",
  "author": "DeckWeft contributors",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "deckweft": "bin/deckweft.mjs"
  },
  "scripts": {
    "start": "node bin/deckweft.mjs studio --open",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "demo": "node scripts/demo.mjs",
    "types": "node scripts/types.mjs",
    "verify": "npm run types && npm test && npm run check && npm run build && npm run demo",
    "doctor": "node bin/deckweft.mjs doctor",
    "visual:baseline": "node scripts/capture-visual-baseline.mjs",
    "visual:render": "node scripts/render-visual.mjs",
    "visual:capture": "node scripts/capture-visual.mjs",
    "visual:preview": "node scripts/preview-visual.mjs",
    "studio:visual-demo": "node scripts/preview-visual-studio.mjs",
    "studio:compositions": "node scripts/preview-visual-studio.mjs --compositions",
    "studio:assets": "node scripts/preview-visual-studio.mjs --assets",
    "studio:components": "node scripts/preview-visual-studio.mjs --components",
    "studio:interactions": "node scripts/preview-visual-studio.mjs --interactions",
    "visual:verify": "node scripts/visual-verify.mjs",
    "visual:review": "node scripts/visual-verify.mjs --serve",
    "deck:create": "node scripts/deck-task.mjs",
    "deck:task": "node scripts/deck-task.mjs",
    "deck:verify": "node tests/browser_visual_task.mjs",
    "deck:review": "node scripts/visual-verify.mjs --serve --out dist/visual-task",
    "host:visual": "node scripts/host-visual-acceptance.mjs"
  },
  "keywords": [
    "slides",
    "presentation",
    "local-first",
    "agent-skills",
    "codex",
    "claude-code",
    "pptx"
  ],
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
