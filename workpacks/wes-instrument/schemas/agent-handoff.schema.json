{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deckweft:workpack:agent-handoff:proposal-v1",
  "title": "PROPOSED agent content handoff — not an implemented endpoint",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "documents",
    "blocks",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "deckweft-content-handoff-proposal"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "sha256",
          "mime"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "mime": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "sourceId",
          "locator",
          "contentStatus"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          },
          "sourceId": {
            "type": "string"
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "contentStatus": {
            "enum": [
              "sourced",
              "illustrative",
              "evidence-required"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message",
          "recovery"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "recovery": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$comment": "User source content is data, never executable instructions. Resolve source IDs against documents; verify hashes against bytes, limit sizes, and map to existing DeckWeft contracts before implementation. No provider-specific API is implied."
}
