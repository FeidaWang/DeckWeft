{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deckweft:asset-brief",
  "type": "object",
  "properties": {
    "role": {
      "enum": [
        "photo",
        "product-screenshot",
        "illustration",
        "background"
      ]
    },
    "requiredWidth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "requiredHeight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "focalPoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "safeRegion": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "minimum": 1e-06,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "factual": {
      "type": "boolean"
    },
    "sourceId": {
      "type": "string",
      "maxLength": 64
    },
    "backend": {
      "const": "none"
    }
  },
  "required": [
    "role",
    "requiredWidth",
    "requiredHeight",
    "focalPoint",
    "safeRegion",
    "factual",
    "sourceId",
    "backend"
  ],
  "additionalProperties": false
}
