{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deckweft:asset-brief",
  "type": "object",
  "properties": {
    "role": {
      "enum": [
        "photo",
        "product-screenshot",
        "illustration",
        "background"
      ]
    },
    "requiredWidth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "requiredHeight": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8192
    },
    "focalPoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "safeRegion": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "factual": {
      "type": "boolean"
    },
    "sourceId": {
      "type": "string",
      "maxLength": 64
    },
    "backend": {
      "const": "none"
    },
    "subjectBounds": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "protectedRegions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "width": {
            "type": "number",
            "minimum": 0.000001,
            "maximum": 1
          },
          "height": {
            "type": "number",
            "minimum": 0.000001,
            "maximum": 1
          }
        },
        "required": [
          "x",
          "y",
          "width",
          "height"
        ],
        "additionalProperties": false
      }
    },
    "contextRegion": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 1
        },
        "height": {
          "type": "number",
          "minimum": 0.000001,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "additionalProperties": false
    },
    "visibleCaption": {
      "type": "string",
      "maxLength": 300
    },
    "detailLocator": {
      "type": "object",
      "properties": {
        "blockId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
        },
        "region": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "width": {
              "type": "number",
              "minimum": 0.000001,
              "maximum": 1
            },
            "height": {
              "type": "number",
              "minimum": 0.000001,
              "maximum": 1
            }
          },
          "required": [
            "x",
            "y",
            "width",
            "height"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "blockId",
        "region"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "role",
    "requiredWidth",
    "requiredHeight",
    "focalPoint",
    "safeRegion",
    "factual",
    "sourceId",
    "backend"
  ],
  "additionalProperties": false
}
