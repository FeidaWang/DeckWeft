{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckweft.local/schemas/film-frame-record.schema.json",
  "title": "DWI-052 film-frame palette record. A frame record exists only for permitted media: the edition, timestamp, transfer function and frame hash are required, so a palette can never claim frame evidence it does not have. No record of this kind exists in the repository yet.",
  "type": "object",
  "properties": {
    "format": {"const": "deckweft-film-frame-record"},
    "version": {"const": 1},
    "paletteId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"},
    "film": {
      "type": "object",
      "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}, "title": {"type": "string", "minLength": 1, "maxLength": 200}, "year": {"type": "integer", "minimum": 1900, "maximum": 2100}, "kind": {"enum": ["feature", "short", "advertisement"]}},
      "required": ["id", "title", "year", "kind"], "additionalProperties": false
    },
    "rights": {
      "type": "object",
      "properties": {"basis": {"enum": ["licensed", "owned-copy-permitted-use", "public-domain"]}, "holder": {"type": "string", "minLength": 1, "maxLength": 300}, "evidence": {"type": "string", "minLength": 1, "maxLength": 500}},
      "required": ["basis", "holder", "evidence"], "additionalProperties": false
    },
    "edition": {
      "type": "object",
      "properties": {"release": {"type": "string", "minLength": 1, "maxLength": 200}, "medium": {"enum": ["blu-ray", "uhd-blu-ray", "dcp", "streaming", "dvd", "film-print-scan"]}, "transferFunction": {"enum": ["bt1886", "srgb", "pq", "hlg", "dci-p3-gamma-2.6", "unknown-recorded-as-unknown"]}, "colorPrimaries": {"enum": ["bt709", "bt2020", "dci-p3", "display-p3", "unknown-recorded-as-unknown"]}},
      "required": ["release", "medium", "transferFunction", "colorPrimaries"], "additionalProperties": false
    },
    "frames": {
      "type": "array", "minItems": 1, "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {"type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}([.:]\\d{2,3})?$"},
          "frameSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "scene": {"type": "string", "maxLength": 200},
          "excluded": {"type": "array", "maxItems": 10, "items": {"enum": ["skin", "subtitles", "letterbox", "neutral-highlights", "neutral-shadows"]}, "uniqueItems": true}
        },
        "required": ["timestamp", "frameSha256", "excluded"], "additionalProperties": false
      }
    },
    "method": {
      "type": "object",
      "properties": {"clustering": {"enum": ["k-means-lab"]}, "k": {"type": "integer", "minimum": 2, "maximum": 16}, "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "weighting": {"enum": ["pixel-count", "equal-per-frame"]}, "deduplicateDeltaE76": {"type": "number", "minimum": 0, "maximum": 50}, "tool": {"type": "string", "minLength": 1, "maxLength": 200}},
      "required": ["clustering", "k", "seed", "weighting", "deduplicateDeltaE76", "tool"], "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {"colors": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "pattern": "^#[0-9A-F]{6}$"}}, "evidence": {"enum": ["licensed-frame-sampled", "independently-reviewed-frame"]}, "reviewer": {"type": "string", "maxLength": 200}},
      "required": ["colors", "evidence"], "additionalProperties": false
    }
  },
  "required": ["format", "version", "paletteId", "film", "rights", "edition", "frames", "method", "result"],
  "additionalProperties": false
}
