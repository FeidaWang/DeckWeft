{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deckweft.local/schemas/palette-registry.schema.json",
  "title": "DWI-010 palette registry: immutable source palettes with provenance. Derived role colours are computed by src/design/semantic-colors.mjs and never stored here.",
  "type": "object",
  "properties": {
    "format": {"const": "deckweft-palette-registry"},
    "registryId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$"},
    "registryVersion": {"type": "integer", "minimum": 1, "maximum": 1000},
    "attribution": {"type": "string", "minLength": 1, "maxLength": 1000},
    "licence": {"type": "string", "minLength": 1, "maxLength": 200},
    "colorSpace": {"type": "string", "minLength": 1, "maxLength": 200},
    "scope": {"type": "string", "minLength": 1, "maxLength": 500},
    "aliases": {"type": "object"},
    "excludedLibraryEntries": {
      "type": "array", "maxItems": 50,
      "items": {"type": "object", "properties": {"id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"}, "reason": {"type": "string", "minLength": 1, "maxLength": 500}}, "required": ["id", "reason"], "additionalProperties": false}
    },
    "palettes": {
      "type": "array", "minItems": 1, "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"},
          "film": {
            "type": "object",
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
              "title": {"type": "string", "minLength": 1, "maxLength": 200},
              "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
              "kind": {"enum": ["feature", "short", "advertisement"]}
            },
            "required": ["id", "title", "year", "kind"], "additionalProperties": false
          },
          "category": {"type": "string", "pattern": "^[a-z][a-z-]{0,39}$"},
          "source": {
            "type": "object",
            "properties": {
              "type": {"const": "community-palette-library"},
              "sourceId": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,39}$"},
              "path": {"type": "string", "minLength": 1, "maxLength": 200},
              "gitBlobSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
              "evidence": {"enum": ["library-values-verified"]},
              "filmFrameVerified": {"const": false},
              "frameTimestamp": {"const": null},
              "officialPalette": {"const": false}
            },
            "required": ["type", "sourceId", "path", "gitBlobSha", "evidence", "filmFrameVerified", "frameTimestamp", "officialPalette"], "additionalProperties": false
          },
          "colors": {
            "type": "array", "minItems": 1, "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "hex": {"type": "string", "pattern": "^#[0-9A-F]{6}$"},
                "rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
                "labD65": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": -200, "maximum": 200}}
              },
              "required": ["hex", "rgb", "labD65"], "additionalProperties": false
            }
          },
          "recommendedUse": {
            "type": "object",
            "properties": {
              "goodFor": {"type": "array", "maxItems": 10, "items": {"type": "string", "pattern": "^[a-z][a-z-]{0,39}$"}},
              "constraints": {"type": "array", "maxItems": 10, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
            },
            "required": ["goodFor", "constraints"], "additionalProperties": false
          }
        },
        "required": ["id", "film", "category", "source", "colors", "recommendedUse"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format", "registryId", "registryVersion", "attribution", "licence", "colorSpace", "scope", "aliases", "excludedLibraryEntries", "palettes"],
  "additionalProperties": false
}
