{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deckweft:web-scene",
  "type": "object",
  "properties": {
    "format": {
      "const": "deckweft-web-scene"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "theme": {
      "enum": [
        "cream-collage",
        "dark-data",
        "electric-violet",
        "editorial-fieldnotes",
        "research-atlas",
        "luminous-stage"
      ]
    },
    "themeVersion": {
      "const": "1.0.0"
    },
    "composition": {
      "enum": [
        "diagonal-cover",
        "chart-with-evidence-rail",
        "reading-flow",
        "photo-split",
        "violet-chapter",
        "fieldnotes-cover",
        "fieldnotes-thesis",
        "fieldnotes-figure",
        "fieldnotes-method",
        "fieldnotes-closing",
        "atlas-cover",
        "atlas-section",
        "atlas-figure",
        "atlas-panels",
        "atlas-appendix",
        "atlas-closing",
        "stage-hero",
        "stage-chapter",
        "stage-figure",
        "stage-metric",
        "stage-closing",
        "statement-split",
        "statement-banner",
        "statement-center",
        "image-left",
        "image-strip",
        "image-right",
        "metric-left",
        "metric-band",
        "metric-right",
        "evidence-left",
        "evidence-top",
        "evidence-right",
        "comparison-matrix",
        "comparison-rail",
        "comparison-stack",
        "process-line",
        "process-rail",
        "process-stair",
        "chapter-low",
        "chapter-index",
        "chapter-margin",
        "before-after-split",
        "before-after-rail",
        "before-after-triptych",
        "system-map-wide",
        "system-map-rail",
        "system-map-key",
        "small-multiples-row",
        "small-multiples-lead",
        "small-multiples-center",
        "quote-center",
        "quote-split",
        "quote-band",
        "closing-split",
        "closing-steps",
        "closing-focus"
      ]
    },
    "focalBlockId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "blockId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "component": {
            "enum": [
              "heading",
              "paragraph",
              "list",
              "quote",
              "metric",
              "table",
              "chart",
              "diagram",
              "code",
              "image",
              "callout",
              "citation",
              "annotation"
            ]
          },
          "crop": {
            "type": "object",
            "properties": {
              "blockId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 1
              }
            },
            "required": [
              "blockId",
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "textRole": {
            "enum": [
              "display",
              "body",
              "caption",
              "code",
              "data",
              "image"
            ]
          },
          "datasetId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "imageSlot": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "blockId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "brief": {
                "type": "object",
                "properties": {
                  "role": {
                    "enum": [
                      "photo",
                      "product-screenshot",
                      "illustration",
                      "background"
                    ]
                  },
                  "requiredWidth": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8192
                  },
                  "requiredHeight": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 8192
                  },
                  "focalPoint": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "x",
                      "y"
                    ],
                    "additionalProperties": false
                  },
                  "safeRegion": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "y": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "width": {
                        "type": "number",
                        "minimum": 0.000001,
                        "maximum": 1
                      },
                      "height": {
                        "type": "number",
                        "minimum": 0.000001,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "width",
                      "height"
                    ],
                    "additionalProperties": false
                  },
                  "factual": {
                    "type": "boolean"
                  },
                  "sourceId": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "backend": {
                    "const": "none"
                  }
                },
                "required": [
                  "role",
                  "requiredWidth",
                  "requiredHeight",
                  "focalPoint",
                  "safeRegion",
                  "factual",
                  "sourceId",
                  "backend"
                ],
                "additionalProperties": false
              },
              "display": {
                "enum": [
                  "crop",
                  "contain"
                ]
              },
              "aspect": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 10
              }
            },
            "required": [
              "id",
              "blockId",
              "brief",
              "display",
              "aspect"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "blockId",
          "component"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "readingOrder": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "graphics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000,
            "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9 .,eE+-]+$"
          },
          "fill": {
            "enum": [
              "paper",
              "ink",
              "accent",
              "secondary",
              "gradient"
            ]
          },
          "rotation": {
            "type": "number",
            "minimum": -360,
            "maximum": 360
          },
          "gradientId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "transform": {
            "type": "object",
            "properties": {
              "translateX": {
                "type": "number",
                "minimum": -1440,
                "maximum": 1440
              },
              "translateY": {
                "type": "number",
                "minimum": -810,
                "maximum": 810
              },
              "scaleX": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 10
              },
              "scaleY": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 10
              },
              "rotate": {
                "type": "number",
                "minimum": -360,
                "maximum": 360
              }
            },
            "required": [
              "translateX",
              "translateY",
              "scaleX",
              "scaleY",
              "rotate"
            ],
            "additionalProperties": false
          },
          "clip": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1440
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 810
              },
              "width": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 1440
              },
              "height": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 810
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "path",
          "fill",
          "rotation"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 30
    },
    "breakpoints": {
      "type": "object",
      "properties": {
        "readingMaxWidth": {
          "const": 700
        },
        "presentationWidth": {
          "const": 1440
        }
      },
      "required": [
        "readingMaxWidth",
        "presentationWidth"
      ],
      "additionalProperties": false
    },
    "gradients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "type": {
            "const": "linear"
          },
          "from": {
            "enum": [
              "paper",
              "ink",
              "accent",
              "secondary"
            ]
          },
          "to": {
            "enum": [
              "paper",
              "ink",
              "accent",
              "secondary"
            ]
          },
          "x1": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y1": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "x2": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y2": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "type",
          "from",
          "to",
          "x1",
          "y1",
          "x2",
          "y2"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 20
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "regionIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "regionIds"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 30
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mode": {
            "enum": [
              "reading",
              "presentation"
            ]
          },
          "layout": {
            "enum": [
              "stack",
              "composition"
            ]
          },
          "readingOrder": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          }
        },
        "required": [
          "mode",
          "layout",
          "readingOrder"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    },
    "interactions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "kind": {
                "const": "chart-select"
              },
              "blockId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "initialSeriesIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "maxItems": 8,
                "minItems": 1,
                "uniqueItems": true
              },
              "initialFocusSeriesId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "initialFromId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "initialToId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "id",
              "kind",
              "blockId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "kind": {
                "const": "image-compare"
              },
              "blockId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "otherBlockId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "initialTab": {
                "enum": [
                  "first",
                  "second",
                  "both"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "blockId",
              "otherBlockId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "kind": {
                "const": "image-hotspots"
              },
              "blockId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "hotspots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "annotationId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    }
                  },
                  "required": [
                    "id",
                    "x",
                    "y",
                    "annotationId"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 8,
                "minItems": 1
              }
            },
            "required": [
              "id",
              "kind",
              "blockId",
              "hotspots"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "kind": {
                "const": "steps"
              },
              "blockId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "steps": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "objectId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10000
                      },
                      "maxItems": 100,
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "explanationId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    }
                  },
                  "required": [
                    "id",
                    "explanationId"
                  ],
                  "additionalProperties": false
                },
                "maxItems": 30,
                "minItems": 1
              },
              "initialStepId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "id",
              "kind",
              "blockId",
              "steps"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 20,
      "minItems": 0
    },
    "cues": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "event": {
                "const": "data.filter"
              },
              "interactionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "seriesIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "maxItems": 8,
                "minItems": 1,
                "uniqueItems": true
              },
              "fromId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "toId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              }
            },
            "required": [
              "id",
              "event",
              "interactionId",
              "seriesIds",
              "fromId",
              "toId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "event": {
                "const": "data.focus"
              },
              "interactionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "seriesId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              }
            },
            "required": [
              "id",
              "event",
              "interactionId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "event": {
                "const": "tab.select"
              },
              "interactionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "tabId": {
                "enum": [
                  "first",
                  "second",
                  "both"
                ]
              },
              "label": {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              }
            },
            "required": [
              "id",
              "event",
              "interactionId",
              "tabId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "event": {
                "const": "step.next"
              },
              "interactionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              }
            },
            "required": [
              "id",
              "event",
              "interactionId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "event": {
                "const": "annotation.reveal"
              },
              "interactionId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "hotspotId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string",
                "maxLength": 200,
                "minLength": 1
              }
            },
            "required": [
              "id",
              "event",
              "interactionId",
              "hotspotId"
            ],
            "additionalProperties": false
          }
        ]
      },
      "maxItems": 100,
      "minItems": 0
    },
    "motion": {
      "type": "object",
      "properties": {
        "policy": {
          "enum": [
            "off",
            "subtle"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 400
        },
        "trigger": {
          "enum": [
            "manual"
          ]
        },
