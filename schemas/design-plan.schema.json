                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
