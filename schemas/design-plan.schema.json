{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deckweft:design-plan",
  "type": "object",
  "properties": {
    "format": {
      "const": "deckweft-design-plan"
    },
    "version": {
      "const": 1
    },
    "documentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "scenes": {
