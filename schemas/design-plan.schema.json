{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deckweft:design-plan",
  "type": "object",
  "properties": {
    "format": {
      "const": "deckweft-design-plan"
    },
    "version": {
      "const": 1
    },
    "documentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "role": {
            "enum": [
              "opening",
              "context",
              "evidence",
              "process",
              "decision",
              "closing"
            ]
          },
          "theme": {
            "enum": [
              "cream-collage",
              "dark-data",
              "electric-violet"
            ]
          },
          "themeVersion": {
            "const": "1.0.0"
          },
          "composition": {
            "enum": [
              "diagonal-cover",
              "chart-with-evidence-rail",
              "reading-flow",
              "photo-split",
              "violet-chapter",
              "statement-split",
              "statement-banner",
              "statement-center",
              "image-left",
              "image-strip",
              "image-right",
              "metric-left",
              "metric-band",
              "metric-right",
              "evidence-left",
              "evidence-top",
              "evidence-right",
              "comparison-matrix",
              "comparison-rail",
              "comparison-stack",
              "process-line",
              "process-rail",
              "process-stair"
            ]
          },
          "blockIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          },
          "focalBlockId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "crops": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "blockId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "width": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                },
                "height": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                }
              },
              "required": [
                "blockId",
                "x",
                "y",
                "width",
                "height"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 100
          },
          "colorMode": {
            "enum": [
              "default",
              "chapter"
            ]
          },
          "graphics": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4000,
                  "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9 .,eE+-]+$"
                },
                "fill": {
                  "enum": [
                    "paper",
                    "ink",
                    "accent",
                    "secondary",
                    "gradient"
                  ]
                },
                "rotation": {
                  "type": "number",
                  "minimum": -360,
                  "maximum": 360
                },
                "gradientId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "transform": {
                  "type": "object",
                  "properties": {
                    "translateX": {
                      "type": "number",
                      "minimum": -1440,
                      "maximum": 1440
                    },
                    "translateY": {
                      "type": "number",
                      "minimum": -810,
                      "maximum": 810
                    },
                    "scaleX": {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 10
                    },
                    "scaleY": {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 10
                    },
                    "rotate": {
                      "type": "number",
                      "minimum": -360,
                      "maximum": 360
                    }
                  },
                  "required": [
                    "translateX",
                    "translateY",
                    "scaleX",
                    "scaleY",
                    "rotate"
                  ],
                  "additionalProperties": false
                },
                "clip": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1440
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 810
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 1440
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 810
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "path",
                "fill",
                "rotation"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 30
          },
          "gradients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "type": {
                  "const": "linear"
                },
                "from": {
                  "enum": [
                    "paper",
                    "ink",
                    "accent",
                    "secondary"
                  ]
                },
                "to": {
                  "enum": [
                    "paper",
                    "ink",
                    "accent",
                    "secondary"
                  ]
                },
                "x1": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y1": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "x2": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "y2": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "id",
                "type",
                "from",
                "to",
                "x1",
                "y1",
                "x2",
                "y2"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 20
          },
          "imageSlots": {
            "type": "array",
            "minItems": 0,
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "blockId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "brief": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "enum": [
                        "photo",
                        "product-screenshot",
                        "illustration",
                        "background"
                      ]
                    },
                    "requiredWidth": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8192
                    },
                    "requiredHeight": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 8192
                    },
                    "focalPoint": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    "safeRegion": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "y": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 1
                        },
                        "width": {
                          "type": "number",
                          "minimum": 1e-06,
                          "maximum": 1
                        },
                        "height": {
                          "type": "number",
                          "minimum": 1e-06,
                          "maximum": 1
                        }
                      },
                      "required": [
                        "x",
                        "y",
                        "width",
                        "height"
                      ],
                      "additionalProperties": false
                    },
                    "factual": {
                      "type": "boolean"
                    },
                    "sourceId": {
                      "type": "string",
                      "maxLength": 64
                    },
                    "backend": {
                      "const": "none"
                    }
                  },
                  "required": [
                    "role",
                    "requiredWidth",
                    "requiredHeight",
                    "focalPoint",
                    "safeRegion",
                    "factual",
                    "sourceId",
                    "backend"
                  ],
                  "additionalProperties": false
                },
                "display": {
                  "enum": [
                    "crop",
                    "contain"
                  ]
                },
                "aspect": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 10
                }
              },
              "required": [
                "id",
                "blockId",
                "brief",
                "display",
                "aspect"
              ],
              "additionalProperties": false
            }
          },
          "interactions": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "kind": {
                      "const": "chart-select"
                    },
                    "blockId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "initialSeriesIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                      },
                      "maxItems": 8,
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "initialFromId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "initialToId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "blockId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "kind": {
                      "const": "image-compare"
                    },
                    "blockId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "otherBlockId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "initialTab": {
                      "enum": [
                        "first",
                        "second",
                        "both"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "blockId",
                    "otherBlockId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "kind": {
                      "const": "image-hotspots"
                    },
                    "blockId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "hotspots": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                          },
                          "x": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "y": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          },
                          "annotationId": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                          }
                        },
                        "required": [
                          "id",
                          "x",
                          "y",
                          "annotationId"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 8,
                      "minItems": 1
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "blockId",
                    "hotspots"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "kind": {
                      "const": "steps"
                    },
                    "blockId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "steps": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                          },
                          "objectId": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                          },
                          "lines": {
                            "type": "array",
                            "items": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 10000
                            },
                            "maxItems": 100,
                            "minItems": 1,
                            "uniqueItems": true
                          },
                          "explanationId": {
                            "type": "string",
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                          }
                        },
                        "required": [
                          "id",
                          "explanationId"
                        ],
                        "additionalProperties": false
                      },
                      "maxItems": 30,
                      "minItems": 1
                    },
                    "initialStepId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "blockId",
                    "steps"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "maxItems": 20,
            "minItems": 0
          },
          "cues": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "event": {
                      "const": "data.filter"
                    },
                    "interactionId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "seriesIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                      },
                      "maxItems": 8,
                      "minItems": 1,
                      "uniqueItems": true
                    },
                    "fromId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "toId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 200,
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "event",
                    "interactionId",
                    "seriesIds",
                    "fromId",
                    "toId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "event": {
                      "const": "tab.select"
                    },
                    "interactionId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "tabId": {
                      "enum": [
                        "first",
                        "second",
                        "both"
                      ]
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 200,
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "event",
                    "interactionId",
                    "tabId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "event": {
                      "const": "step.next"
                    },
                    "interactionId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 200,
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "event",
                    "interactionId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "event": {
                      "const": "annotation.reveal"
                    },
                    "interactionId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "hotspotId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 200,
                      "minLength": 1
                    }
                  },
                  "required": [
                    "id",
                    "event",
                    "interactionId",
                    "hotspotId"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "maxItems": 100,
            "minItems": 0
          },
          "motion": {
            "type": "object",
            "properties": {
              "policy": {
                "enum": [
                  "off",
                  "subtle"
                ]
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 400
              },
              "trigger": {
                "enum": [
                  "manual"
                ]
              },
              "clock": {
                "enum": [
                  "cues"
                ]
              },
              "reducedMotion": {
                "enum": [
                  "instant",
                  "static"
                ]
              }
            },
            "required": [
              "policy",
              "durationMs"
            ],
            "additionalProperties": false
          },
          "profile": {
            "type": "object",
            "properties": {
              "colorIntensity": {
                "enum": [
                  "restrained",
                  "bold"
                ]
              },
              "typographicContrast": {
                "enum": [
                  "balanced",
                  "expressive"
                ]
              },
              "density": {
                "enum": [
                  "comfortable",
                  "compact"
                ]
              },
              "motionIntensity": {
                "enum": [
                  "off",
                  "subtle"
                ]
              },
              "imageEmphasis": {
                "enum": [
                  "balanced",
                  "large"
                ]
              }
            },
            "required": [
              "colorIntensity",
              "typographicContrast",
              "density",
              "motionIntensity",
              "imageEmphasis"
            ],
            "additionalProperties": false
          },
          "takeaway": {
            "type": "object",
            "properties": {
              "blockId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "blockId"
            ],
            "additionalProperties": false
          },
          "contentStatus": {
            "enum": [
              "sourced",
              "illustrative",
              "evidence-required"
            ]
          },
          "keyStates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "position": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "id",
                "position"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "maxItems": 20
          },
          "staticState": {
            "type": "object",
            "properties": {
              "keyStateId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "keyStateId"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "role",
          "theme",
          "themeVersion",
          "composition",
          "blockIds",
          "focalBlockId"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    }
  },
  "required": [
    "format",
    "version",
    "documentId",
    "scenes"
  ],
  "additionalProperties": false
}
