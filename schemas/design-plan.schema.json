                  "maxLength": 4000,
                  "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9 .,eE+-]+$"
                },
                "fill": {
                  "enum": [
                    "paper",
                    "ink",
                    "accent",
                    "secondary",
                    "gradient"
