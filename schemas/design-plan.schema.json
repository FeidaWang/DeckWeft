            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
          },
          "role": {
            "enum": [
              "opening",
              "context",
              "evidence",
              "process",
              "decision",
              "closing"
            ]
          },
          "theme": {
            "enum": [
              "cream-collage",
              "dark-data",
              "electric-violet",
              "silver-gray-editorial",
              "fresh-report",
              "orange-launch"
            ]
          },
          "themeVersion": {
            "const": "1.0.0"
          },
          "composition": {
            "enum": [
              "diagonal-cover",
              "chart-with-evidence-rail",
              "reading-flow",
              "photo-split",
              "violet-chapter",
              "fieldnotes-cover",
              "fieldnotes-thesis",
              "fieldnotes-figure",
              "fieldnotes-method",
              "fieldnotes-closing",
              "atlas-cover",
              "atlas-section",
              "atlas-figure",
              "atlas-panels",
              "atlas-appendix",
              "atlas-closing",
              "stage-hero",
              "stage-chapter",
              "stage-figure",
              "stage-metric",
              "stage-closing",
              "statement-split",
              "statement-banner",
              "statement-center",
              "image-left",
              "image-strip",
              "image-right",
              "metric-left",
              "metric-band",
              "metric-right",
              "evidence-left",
              "evidence-top",
              "evidence-right",
              "comparison-matrix",
              "comparison-rail",
              "comparison-stack",
              "process-line",
              "process-rail",
              "process-stair",
              "chapter-low",
              "chapter-index",
              "chapter-margin",
              "before-after-split",
              "before-after-rail",
              "before-after-triptych",
              "system-map-wide",
              "system-map-rail",
              "system-map-key",
              "small-multiples-row",
              "small-multiples-lead",
              "small-multiples-center",
              "quote-center",
              "quote-split",
              "quote-band",
              "closing-split",
              "closing-steps",
              "closing-focus"
