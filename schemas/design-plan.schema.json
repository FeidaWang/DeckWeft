                },
                "rotation": {
                  "type": "number",
                  "minimum": -360,
                  "maximum": 360
                },
                "gradientId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "transform": {
                  "type": "object",
                  "properties": {
                    "translateX": {
                      "type": "number",
                      "minimum": -1440,
                      "maximum": 1440
                    },
                    "translateY": {
                      "type": "number",
                      "minimum": -810,
                      "maximum": 810
                    },
                    "scaleX": {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 10
                    },
                    "scaleY": {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 10
                    },
                    "rotate": {
                      "type": "number",
                      "minimum": -360,
                      "maximum": 360
                    }
                  },
                  "required": [
                    "translateX",
                    "translateY",
                    "scaleX",
                    "scaleY",
                    "rotate"
                  ],
                  "additionalProperties": false
                },
                "clip": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1440
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 810
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 1440
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0.01,
                      "maximum": 810
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "path",
                "fill",
                "rotation"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 30
          },
          "gradients": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
                },
                "type": {
