                            "x": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "y": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 1
                            },
                            "width": {
                              "type": "number",
                              "minimum": 0.000001,
                              "maximum": 1
                            },
                            "height": {
                              "type": "number",
                              "minimum": 0.000001,
                              "maximum": 1
                            }
                          },
                          "required": [
                            "x",
                            "y",
                            "width",
                            "height"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [
                        "blockId",
                        "region"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "role",
                    "requiredWidth",
                    "requiredHeight",
                    "focalPoint",
                    "safeRegion",
                    "factual",
                    "sourceId",
                    "backend"
