{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Host structured response contracts",
 "$defs": {
  "outline": {
   "type": "object",
   "description": "F3: a structured outline. Each page is a list of lines; the first line is the heading. A line that reproduces a numbered source line carries that number (byte-equal after trimming, each number exactly once, in source order); every other line carries 0 and is recorded as host-authored.",
   "properties": {
    "pages": {
     "type": "array",
     "minItems": 1,
     "maxItems": 60,
     "items": {
      "type": "object",
      "properties": {
       "lines": {
        "type": "array",
        "minItems": 1,
        "maxItems": 80,
        "items": {
         "type": "object",
         "properties": {
          "text": {
           "type": "string",
           "minLength": 1,
           "maxLength": 2000
          },
          "sourceLine": {
           "type": "integer",
           "minimum": 0,
           "maximum": 4000
          }
         },
         "required": [
          "text",
          "sourceLine"
         ],
         "additionalProperties": false
        }
       }
      },
      "required": [
       "lines"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "pages"
   ],
   "additionalProperties": false
  },
  "patch": {
   "type": "object",
   "properties": {
    "kind": {
     "type": "string",
     "enum": [
      "composition",
      "chart"
     ]
    },
    "sceneId": {
     "type": "string",
     "maxLength": 64
    },
    "composition": {
     "type": "string",
     "maxLength": 64
    },
    "datasetId": {
     "type": "string",
     "maxLength": 64
    }
   },
   "required": [
    "kind",
    "sceneId",
    "composition",
    "datasetId"
   ],
   "additionalProperties": false
  },
  "review": {
   "type": "object",
   "properties": {
    "verdict": {
     "type": "string",
     "enum": [
      "pass",
      "fail"
     ]
    },
    "judgment": {
     "type": "string",
     "minLength": 1,
     "maxLength": 8000
    },
    "images": {
     "type": "array",
     "minItems": 1,
     "maxItems": 20,
     "items": {
      "type": "object",
      "properties": {
       "file": {
        "type": "string",
        "maxLength": 255
       },
       "sha256": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
       },
       "finding": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
       }
      },
      "required": [
       "file",
       "sha256",
       "finding"
      ],
      "additionalProperties": false
     }
    },
    "issues": {
     "type": "array",
     "maxItems": 60,
     "items": {
      "type": "object",
      "properties": {
       "sceneId": {
        "type": "string",
        "maxLength": 64
       },
       "nodeId": {
        "type": "string",
        "maxLength": 64
       },
       "bounds": {
        "type": "object",
        "properties": {
         "x": {
          "type": "number"
         },
         "y": {
          "type": "number"
         },
         "width": {
          "type": "number"
         },
         "height": {
          "type": "number"
         }
        },
        "required": [
         "x",
         "y",
         "width",
         "height"
        ],
        "additionalProperties": false
       },
       "severity": {
        "type": "string",
        "enum": [
         "error",
         "warning"
        ]
       },
       "reason": {
        "type": "string",
        "maxLength": 2000
       },
       "suggestion": {
        "type": "string",
        "maxLength": 2000
       }
      },
      "required": [
       "sceneId",
       "nodeId",
       "bounds",
       "severity",
       "reason",
       "suggestion"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "verdict",
    "judgment",
    "images",
    "issues"
   ],
   "additionalProperties": false
  },
  "reviewControls": {
   "type": "array",
   "maxItems": 20,
   "description": "F5: for every attached image, the three digits of the verification tag as read from the pixels and the tag's pixel bounds. Bound to the review only when a pixel control is placed.",
   "items": {
    "type": "object",
    "properties": {
     "file": {
      "type": "string",
      "maxLength": 255
     },
     "text": {
      "type": "string",
      "pattern": "^[0-9?]{3}$"
     },
     "bounds": {
      "type": "object",
      "properties": {
       "x": {
        "type": "number"
       },
       "y": {
        "type": "number"
       },
       "width": {
        "type": "number"
       },
       "height": {
        "type": "number"
       }
      },
      "required": [
       "x",
       "y",
       "width",
       "height"
      ],
      "additionalProperties": false
     }
    },
    "required": [
     "file",
     "text",
     "bounds"
    ],
    "additionalProperties": false
   }
  }
 }
}
