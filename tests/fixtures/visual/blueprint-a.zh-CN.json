  "title": "从页面到文件：DeckWeft 导出流程的四个部分",
  "locale": "zh-CN",
  "visualBrief": {
   "audience": "需要了解导出为何会被拒绝的作者。",
   "outputLanguage": "zh-CN",
   "profile": {
    "colorIntensity": "restrained",
    "typographicContrast": "expressive",
    "density": "comfortable",
    "motionIntensity": "subtle",
    "imageEmphasis": "large"
