  "title": "From page to file: the four parts of the DeckWeft export pipeline",
  "locale": "en",
  "visualBrief": {
   "audience": "Authors who need to know why an export can be refused.",
   "outputLanguage": "en",
   "profile": {
    "colorIntensity": "restrained",
    "typographicContrast": "expressive",
